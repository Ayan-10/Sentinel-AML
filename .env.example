# Copy to .env and adjust. .env is git-ignored and never committed.
# ---------------------------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_in_real_deployments

# Demo analyst credentials (NFR: no hardcoded secrets - injected at runtime)
SENTINEL_ANALYST_PASSWORD=analyst123
SENTINEL_SENIOR_PASSWORD=senior123
SENTINEL_ADMIN_PASSWORD=admin123

# Detection tuning
SENTINEL_WORKER_THREADS=8
SENTINEL_BULK_CHUNK_SIZE=2000
